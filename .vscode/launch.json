{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit: app.py",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "cwd": "${workspaceFolder}",
      "args": [
        "run",
        "app.py",
        "--server.address",
        "127.0.0.1",
        "--server.port",
        "8502",
        "--server.runOnSave",
        "true"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
